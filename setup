#!/bin/bash

set -e

export BBENV="$(cd "$(dirname "$0")" && pwd)"
cd "$BBENV"

function header {
  printf '\n\e[4;1m%s\e[0m\n' "$1"
}

# =============================================================================
# apt packages used by the rest of the script
# =============================================================================
header "SETUP APT"
sudo apt-get -y update
sudo apt-get -y install \
  build-essential \
  cmake \
  coreutils \
  curl \
  git \
  grep \
  perl \
  jq \
  zip unzip \
  zsh \
  ;

# =============================================================================
# setup XDG_CONFIG_HOME
# =============================================================================
header "SETUP CONFIG"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CONFIG"
for src in "$BBENV"/xdg_config/*; do
  dst="$CONFIG/$(basename "$src")"
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    bak="$dst.bak-$(date +%Y%m%d-%H%M%S)"
    echo "$dst is in the way - moving it to $bak"
    mv "$dst" "$bak"
  fi
  ln -sfn "$src" "$dst"
done
for link in "$CONFIG"/*; do
  if [ -L "$link" ] && [ ! -e "$link" ]; then
    case "$(readlink "$link")" in
      "$BBENV"/*) echo "Removing dangling link $link"; rm "$link" ;;
    esac
  fi
done
ln -sf "$BBENV/.zshenv" "$HOME/.zshenv"

# =============================================================================
# setup zsh
# =============================================================================
header "SETUP ZSH"
touch "$CONFIG/zsh/.zshrc.local"
curl -fsS --create-dirs -L -o "$CONFIG/zsh/plugins/zsh-history-substring-search.zsh" \
    https://raw.githubusercontent.com/zsh-users/zsh-history-substring-search/master/zsh-history-substring-search.zsh

SHELL_CHANGED=0
ZSH_BIN="$(command -v zsh)"
LOGIN_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [ "$(realpath "$LOGIN_SHELL")" != "$(realpath "$ZSH_BIN")" ]; then
    sudo chsh -s "$ZSH_BIN" "$USER"
    SHELL_CHANGED=1
fi

# =============================================================================
# install other components using zsh so that they have paths from .zshenv
# =============================================================================
. "$HOME/.zshenv"
if dpkg -s gnome-shell >/dev/null 2>&1; then
  . ./setup-gnome.zsh
  . ./setup-fonts.zsh
fi
. ./setup-python.zsh
. ./setup-git.zsh
. ./setup-go.zsh
. ./setup-rust.zsh
. ./setup-nodejs.zsh
. ./setup-lua.zsh
. ./setup-language-servers.zsh
. ./setup-neovim.zsh

# =============================================================================
# Misc tools
# =============================================================================
header "INSTALL MORE MISC TOOLS"
go install github.com/jesseduffield/lazygit@latest

# =============================================================================
# run post-install configurations
# =============================================================================
. ./configure-git.zsh

if [ "$SHELL_CHANGED" = 1 ]; then
    echo "Logout and log back in to finish changing shells"
fi
